<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>AgenticResearchHub.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticResearchHub.Core\AgenticResearchHub.Core.csproj" />
    <ProjectReference Include="..\AgenticResearchHub.Infrastructure\AgenticResearchHub.Infrastructure.csproj" />
