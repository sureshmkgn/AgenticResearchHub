# ==============================================================================
# Agentic Research Hub - Microsoft .NET Enterprise Environment Configuration
# ==============================================================================

# LLM Gateway Configuration (OpenAI, AzureOpenAI, LiteLLM, Ollama, LocalFallback)
LLM_PROVIDER=OpenAI
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL_ID=gpt-4o
LLM_EMBEDDING_MODEL_ID=text-embedding-3-small

# Azure OpenAI Specifics (when LLM_PROVIDER=AzureOpenAI)
# LLM_ENDPOINT=https://your-azure-resource.openai.azure.com
# LLM_API_KEY=your_azure_api_key
# LLM_MODEL_ID=your-gpt4o-deployment-name
# LLM_EMBEDDING_MODEL_ID=your-embedding-deployment-name

# Web Search Provider (DuckDuckGo, Bing, MCP)
WEB_SEARCH_PROVIDER=DuckDuckGo
BING_API_KEY=your_bing_search_v7_key_here

# Model Context Protocol (MCP) Server Integration (Optional)
# MCP_SERVER_URL=http://localhost:8000/mcp
